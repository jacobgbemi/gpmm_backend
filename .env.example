# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (PostgreSQL)
DATABASE_URL=postgres://glintpm:glintpm@localhost:5432/glintpm_dev
# Or individual settings:
# DB_NAME=glintpm_dev
# DB_USER=glintpm
# DB_PASSWORD=glintpm
# DB_HOST=localhost
# DB_PORT=5432

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional: Email (for later phases)
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@glintpm.com

# Optional: Payment provider (for later phases)
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=
