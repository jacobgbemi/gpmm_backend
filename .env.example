# Copy this file to .env and fill in values. Never commit .env.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Database (PostgreSQL)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://glintpm:glintpm@localhost:5432/glintpm

# Optional: force SQLite for quick local runs without PostgreSQL
# USE_SQLITE=true

# CORS (comma-separated origins; ignored when CORS_ALLOW_ALL_ORIGINS is used in development)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Production-only (set in production environment)
# SECURE_SSL_REDIRECT=true
